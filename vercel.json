{
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    { "source": "/tvvozdebrasiliafilmes/lunardi", "destination": "https://youtu.be/5zl9bu3rG-k", "permanent": false }
  ],
  "rewrites": [
    { "source": "/moveis-decoracao", "destination": "/moveis-decoracao/index.html" },
    { "source": "/moveis-decoracao/", "destination": "/moveis-decoracao/index.html" },
    { "source": "/mobilidade", "destination": "/mobilidade/index.html" },
    { "source": "/mobilidade/", "destination": "/mobilidade/index.html" },
    { "source": "/energia", "destination": "/energia/home.html" },
    { "source": "/energia/", "destination": "/energia/home.html" },
    { "source": "/portais/poder.html", "destination": "/api/poder" },
    { "source": "/portais/:slug.html", "destination": "/portal.html" },
    { "source": "/clientes/:slug.html", "destination": "/cliente.html" },
    { "source": "/analises/:slug", "destination": "/api/analysis-page?slug=:slug" },
    { "source": "/tema/:slug", "destination": "/api/seo-hub?type=tema&slug=:slug" },
    { "source": "/autor/:slug", "destination": "/api/seo-hub?type=autor&slug=:slug" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Link", "value": "</mercia-mature.css>; rel=stylesheet" }
      ]
    },
    {
      "source": "/assets/v33-original/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
